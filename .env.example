SMART_CRANE_DEMO_MODE=true
# Optional, read-only Azure DevOps connector. Never commit a PAT.
ADO_ORG=
ADO_PROJECT=
ADO_PAT=
SMART_CRANE_SOURCE_ROOT=work/smart_crane_sources
SMART_CRANE_NOTES_ROOT=C:/Users/Admin/Downloads
# Optional Smart Crane edge database through an SSH tunnel. Use a dedicated read-only role.
SMART_CRANE_POSTGRES_HOST=127.0.0.1
SMART_CRANE_POSTGRES_PORT=15432
SMART_CRANE_POSTGRES_DATABASE=api_edge
SMART_CRANE_POSTGRES_USER=
SMART_CRANE_POSTGRES_PASSWORD=
# Optional production fleet telemetry. Use a dedicated read-only Cassandra identity.
SMART_CRANE_COSMOS_HOST=
SMART_CRANE_COSMOS_PORT=10350
SMART_CRANE_COSMOS_USERNAME=
SMART_CRANE_COSMOS_PASSWORD=
SMART_CRANE_COSMOS_KEYSPACE=cloud_core
INCIDENT_MEMORY_PATH=work/incident_memory.sqlite3
EVIDENCE_LEDGER_PATH=work/evidence_ledger.sqlite3
