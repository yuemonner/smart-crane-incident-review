ACECO_DEMO_MODE=true
# Optional, read-only Azure DevOps connector. Never commit a PAT.
ADO_ORG=
ADO_PROJECT=
ADO_PAT=
ACECO_SOURCE_ROOT=work/aceco_sources
ACECO_NOTES_ROOT=C:/Users/Admin/Downloads
# Optional ACECO edge database through an SSH tunnel. Use a dedicated read-only role.
ACECO_POSTGRES_HOST=127.0.0.1
ACECO_POSTGRES_PORT=15432
ACECO_POSTGRES_DATABASE=api_edge
ACECO_POSTGRES_USER=
ACECO_POSTGRES_PASSWORD=
# Optional production fleet telemetry. Use a dedicated read-only Cassandra identity.
ACECO_COSMOS_HOST=
ACECO_COSMOS_PORT=10350
ACECO_COSMOS_USERNAME=
ACECO_COSMOS_PASSWORD=
ACECO_COSMOS_KEYSPACE=cloud_core
INCIDENT_MEMORY_PATH=work/incident_memory.sqlite3
EVIDENCE_LEDGER_PATH=work/evidence_ledger.sqlite3
